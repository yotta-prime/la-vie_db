# Copy to .env and fill in. Never commit .env.

# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Leave empty, start the service, send /start to your bot, then paste the ID it replies with.
TELEGRAM_OWNER_CHAT_ID=

# Password for the admin page (http://<nas-ip>:8080/admin). Use a long random one.
ADMIN_PASSWORD=

TIMEZONE=Europe/London
BACKUP_KEEP=14
